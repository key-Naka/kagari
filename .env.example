MYSQL_DATABASE=kagari
MYSQL_USER=kagari
MYSQL_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
REDIS_PASSWORD=replace-with-a-unique-redis-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
SESSION_TTL=24h
DOCKER_PROXY_URL=http://docker-proxy:2375
HOST_METRICS_URL=http://host-metrics:8090
STATUS_HTTP_URL=http://frontend:3000/
QINIU_ACCESS_KEY=replace-with-qiniu-access-key
QINIU_SECRET_KEY=replace-with-qiniu-secret-key
QINIU_BUCKET=replace-with-qiniu-bucket-name
QINIU_PUBLIC_BASE_URL=https://replace-with-qiniu-default-domain
