BACKEND_PORT=127.0.0.1:18080
NUXT_PUBLIC_API_BASE=https://api.example.com
MYSQL_DSN=kagari:replace-with-a-unique-database-password@tcp(mysql:3306)/kagari?charset=utf8mb4&parseTime=True&loc=UTC
